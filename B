class SportsPage extends StatelessWidget {
  const SportsPage({super.key});

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('All Sports'),
      ),
      body: ListView(
        padding: const EdgeInsets.all(16),
        children: [
          _sportsItem(
            context,
            Icons.sports_cricket,
            'Cricket',
            Colors.green,
            const CricketPage(),
          ),
          _sportsItem(
            context,
            Icons.sports_soccer,
            'Football',
            Colors.orange,
            const FootballPage(),
          ),
          _sportsItem(
            context,
            Icons.sports_tennis,
            'Tennis',
            Colors.blue,
            const TennisPage(),
          ),
          _sportsItem(
            context,
            Icons.sports_basketball,
            'Basketball',
            Colors.red,
            const BasketballPage(),
          ),
        ],
      ),
    );
  }

  Widget _sportsItem(
    BuildContext context,
    IconData icon,
    String title,
    Color color,
    Widget page,
  ) {
    return Card(
      margin: const EdgeInsets.only(bottom: 15),
      child: ListTile(
        contentPadding: const EdgeInsets.all(15),
        leading: Icon(
          icon,
          size: 40,
          color: color,
        ),
        title: Text(
          title,
          style: const TextStyle(
            fontSize: 20,
            fontWeight: FontWeight.bold,
          ),
        ),
        subtitle: const Text('Tap to view information'),
        trailing: const Icon(Icons.arrow_forward_ios),
        onTap: () {
          Navigator.push(
            context,
            MaterialPageRoute(
              builder: (context) => page,
            ),
          );
        },
      ),
    );
  }
}

